<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.fluid-smoke" path="/org/gnome/shell/extensions/fluid-smoke/">
    <key name="debug-view" type="s">
      <choices><choice value="normal"/><choice value="velocity"/><choice value="curl"/><choice value="density"/><choice value="divergence"/><choice value="layers"/></choices>
      <default>'normal'</default><summary>Temporary developer GPU view (not a visual preference)</summary>
    </key>
    <key name="smoke-amount" type="d">
      <range min="0.5" max="3.0"/><default>1.75</default>
      <summary>Smoke source strength multiplier</summary>
    </key>
    <key name="linger-time" type="d">
      <range min="4.0" max="20.0"/><default>10.0</default>
      <summary>Seconds smoke fades before clearing after the last motion</summary>
    </key>
    <key name="swirl" type="d">
      <range min="4.0" max="10.0"/><default>8.0</default>
      <summary>Strength of small fluid curls</summary>
    </key>
    <key name="viscosity" type="d">
      <range min="0.05" max="0.6"/><default>0.15</default>
      <summary>Fluid viscosity in grid cells squared per second</summary>
    </key>
    <key name="color-mode" type="s">
      <choices><choice value="rainbow"/><choice value="solid"/><choice value="gradient"/></choices>
      <default>'rainbow'</default><summary>Smoke color mode</summary>
    </key>
    <key name="primary-color" type="s">
      <default>'#66ccff'</default><summary>Primary smoke color in #RRGGBB format</summary>
    </key>
    <key name="secondary-color" type="s">
      <default>'#ff66cc'</default><summary>Second smoke color in #RRGGBB format</summary>
    </key>
  </schema>
</schemalist>
